# Appended to /boot/firmware/config.txt (under [all]).
# Forces a fake 400x300 HDMI mode so the console framebuffer matches the
# e-paper resolution. SPI and I2C are enabled separately via raspi-config.
[all]
framebuffer_width=400
framebuffer_height=300
hdmi_force_hotplug=1
hdmi_group=2
hdmi_mode=87
hdmi_cvt=400 300 60 1 0 0 0
disable_overscan=1
max_framebuffers=2
